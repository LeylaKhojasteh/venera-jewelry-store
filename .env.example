# ── Database ────────────────────────────────────────────────────────────────
# Vercel + Neon: use the pooled (PgBouncer) URL at runtime.
# Use the direct URL for `prisma migrate deploy` (see README).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL=""

# ── Auth ────────────────────────────────────────────────────────────────────
# 32+ random bytes: openssl rand -base64 32
AUTH_SECRET=""

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"

# ── Demo checkout (integer Toman) ──────────────────────────────────────────
SHIPPING_FLAT_TOMAN="45000"
FREE_SHIPPING_THRESHOLD_TOMAN="5000000"

# ── Seed (demo only) ───────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@venera.example"
SEED_ADMIN_PASSWORD="change-me-before-seeding"
SEED_ADMIN_NAME="مدیر ونرا"
SEED_CUSTOMER_EMAIL="demo@venera.example"
SEED_CUSTOMER_PASSWORD="change-me-before-seeding"
SEED_CUSTOMER_NAME="سارا کریمی"
